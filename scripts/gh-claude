#!/usr/bin/env bash
set -euo pipefail

readonly BOT_LOGINS_RE='^(github-actions|claude)$'

usage() {
  cat << USAGE
Usage: ${0##*/} SUBCOMMAND ARGS...   (body on stdin)

  inline PR PATH LINE               review comment on the PR head, RIGHT side
  reply PR COMMENT_ID               reply in a review thread
  comment NUMBER                    top-level PR or issue comment
  resolve THREAD_ID                 resolve a thread started by github-actions/claude

Env: GITHUB_REPOSITORY, GH_TOKEN
USAGE
}

die() {
  echo "${0##*/}: $*" >&2
  exit 1
}

# Buffer first: a `< file` redirect could feed /proc/self/environ.
read_body() {
  local body var
  body=$(cat)
  for var in ANTHROPIC_API_KEY GH_TOKEN GITHUB_TOKEN; do
    [[ -z "${!var-}" || "${body}" != *"${!var}"* ]] || die "body contains a secret, refusing"
  done
  printf '%s' "${body}"
}

num() {
  [[ "${2-}" =~ ^[0-9]+$ ]] || die "$1 must be a number, got '${2-}'"
}

inline() {
  [[ $# -eq 3 ]] || die "inline needs PR PATH LINE"
  local pr="$1" path="$2" line="$3"
  num PR "${pr}"
  num LINE "${line}"
  local sha body
  body=$(read_body)
  sha=$(gh pr view "${pr}" --json headRefOid --jq .headRefOid)
  printf '%s' "${body}" | gh api "repos/${GITHUB_REPOSITORY}/pulls/${pr}/comments" \
    -f "commit_id=${sha}" -f "path=${path}" -f side=RIGHT \
    -F "line=${line}" -F body=@- --jq .html_url
}

reply() {
  [[ $# -eq 2 ]] || die "reply needs PR COMMENT_ID"
  num PR "$1"
  num COMMENT_ID "$2"
  local body
  body=$(read_body)
  printf '%s' "${body}" | gh api \
    "repos/${GITHUB_REPOSITORY}/pulls/$1/comments/$2/replies" \
    -F body=@- --jq .html_url
}

comment() {
  [[ $# -eq 1 ]] || die "comment needs NUMBER"
  num NUMBER "$1"
  local body
  body=$(read_body)
  printf '%s' "${body}" | gh issue comment "$1" --body-file -
}

# shellcheck disable=SC2016 # $id is a GraphQL variable
resolve() {
  [[ $# -eq 1 ]] || die "resolve needs THREAD_ID"
  [[ "$1" =~ ^[A-Za-z0-9_=-]+$ ]] || die "invalid THREAD_ID '$1'"
  local author
  author=$(gh api graphql -F id="$1" -f query='
    query($id: ID!) {
      node(id: $id) {
        ... on PullRequestReviewThread {
          comments(first: 1) { nodes { author { login } } }
        }
      }
    }' --jq '.data.node.comments.nodes[0].author.login')
  [[ "${author}" =~ ${BOT_LOGINS_RE} ]] \
    || die "thread $1 was started by '${author}', not resolving"
  gh api graphql -F id="$1" -f query='
    mutation($id: ID!) {
      resolveReviewThread(input: {threadId: $id}) { thread { isResolved } }
    }' > /dev/null
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    -h | --help)
      usage
      exit 0
      ;;
    inline | reply | comment | resolve)
      shift
      [[ -n "${GITHUB_REPOSITORY-}" ]] || die "GITHUB_REPOSITORY is not set"
      "${cmd}" "$@"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
